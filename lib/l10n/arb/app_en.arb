  "detailsAppearances": "Appearances",
  "statComics": "Comics",
  "statSeries": "Series",
  "statStories": "Stories",
  "statEvents": "Events",
  "detailsSeries": "Series",
  "detailsNoSeries": "This hero hasn't appeared in any series yet.",
  "detailsMoreSeries": "{count, plural, =1{+1 more series} other{+{count} more series}}",
  "@detailsMoreSeries": { "placeholders": { "count": { "type": "int" } } },

  "marvelAttribution": "Data provided by Marvel. © {year} MARVEL",
  "@marvelAttribution": { "placeholders": { "year": { "type": "int", "format": "decimalPattern", "optionalParameters": { "decimalDigits": 0 } } } },

  "missingConfigTitle": "Marvel API keys missing",
  "missingConfigMessage": "Copy env.example.json to env.json, add your keys from developer.marvel.com and run the app with:"
